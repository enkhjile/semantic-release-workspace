{
  "name": "semantic-release-workspace",
  "version": "0.0.0-development",
  "description": "Workspace-aware monorepo releases for semantic-release.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "pnpm build && vitest run --maxWorkers=2",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepack": "pnpm build",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "peerDependencies": {
    "semantic-release": "^25.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@sigstore/mock": "0.12.1",
    "@tufjs/repo-mock": "4.0.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@npmcli/agent": "4.0.2",
    "@npmcli/config": "10.14.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/error": "4.0.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "fast-glob": "3.3.3",
    "libnpmpublish": "11.2.1",
    "npm-registry-fetch": "19.1.1",
    "semver": "7.8.5",
    "sigstore": "4.1.1",
    "smol-toml": "1.9.1",
    "tar": "7.5.22",
    "toml-eslint-parser": "1.0.3",
    "yaml": "2.9.1"
  }
}
